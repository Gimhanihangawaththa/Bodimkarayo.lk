# Copy this file to .env before running the backend natively (./mvnw spring-boot:run)
# cp .env.example .env

# Required for the AI Matchmaker feature. Get a key from https://aistudio.google.com/apikey
# Without this, /api/recommendations falls back to empty results.
GEMINI_API_KEY=

# Optional: only needed if your MariaDB/Elasticsearch aren't on the default localhost ports
# (e.g. when running the backend natively against the Dockerized db/elasticsearch services,
# whose ports are published as 3307/9200 on the host instead of 3306/9200)
# SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3307/bodimkarayo_db
# SPRING_DATASOURCE_USERNAME=bodim_user
# SPRING_DATASOURCE_PASSWORD=StrongPassword123!
